# ===== 依赖与构建产物 =====
node_modules/
dist/
build/
*.tsbuildinfo
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ===== 环境变量（密钥不入库）=====
.env
.env.*
!.env.example
*.local

# ===== 数据目录（上传文件 / 处理结果 / 向量库，运行时生成，不入库；backend 与 ai-service 共享 backend/data）=====
backend/data/uploads/*
backend/data/processed/*
backend/data/vector/*
backend/data/files.json
!backend/data/uploads/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/vector/.gitkeep

# ===== AI 服务运行时数据（本地模型启动时自动下载，不入库）=====
ai-service/data/

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 编辑器 / IDE / 系统文件 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
