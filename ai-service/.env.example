# LLM API 配置（OpenAI 兼容接口，支持 DeepSeek / 混元）
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 大纲/提纲类任务专用模型（可选，未配置时回落主模型）
# 大纲是中间产物，可指向免费/便宜模型，如智谱 GLM-4-Flash（bigmodel.cn 注册拿 key）：
# LLM_OUTLINE_API_KEY=your_zhipu_key
# LLM_OUTLINE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_OUTLINE_MODEL=glm-4-flash

# 数据目录
CHROMA_DIR=./data/vector
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# Embedding 模型（本地路径）
EMBEDDING_MODEL=./data/models/bge-small-zh-v1.5

# RAG 检索相关性阈值（余弦相似度；min 硬阈值，floor 全池兜底，见 app/config.py 注释）
RAG_MIN_SIMILARITY=0.5
RAG_FLOOR_SIMILARITY=0.25

# 离线模式（模型已本地化，禁止联网下载）
HF_HUB_OFFLINE=1
