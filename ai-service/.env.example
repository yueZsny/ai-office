# LLM API 配置（OpenAI 兼容接口，支持 DeepSeek / 混元）
# 前端「模型设置」页写入 PostgreSQL 的配置优先于这里；未在设置页指定时使用以下默认值
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 大纲/提纲类任务专用模型（可选，未配置时回落主模型）
# 大纲是中间产物，可指向免费/便宜模型，如智谱 GLM-4-Flash（bigmodel.cn 注册拿 key）：
# LLM_OUTLINE_API_KEY=your_zhipu_key
# LLM_OUTLINE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_OUTLINE_MODEL=glm-4-flash

# 数据目录
CHROMA_DIR=./data/vector
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# Embedding 模型（本地路径）
EMBEDDING_MODEL=./data/models/bge-small-zh-v1.5

# RAG 检索相关性阈值（余弦相似度；min 硬阈值，floor 全池兜底，见 app/config.py 注释）
RAG_MIN_SIMILARITY=0.5
RAG_FLOOR_SIMILARITY=0.25

# 离线模式（模型已本地化，禁止联网下载）
HF_HUB_OFFLINE=1

# ---- Redis 缓存（fail-open：连不上只记日志，业务照常走原路径）----
# 用 db 1 与 backend 限流（db 0）隔离，可安全清缓存
REDIS_URL=redis://127.0.0.1:6379/1
# LLM 结果缓存 TTL（小时）：summary / mindmap-llm / outline / section
REDIS_CACHE_TTL_HOURS=24
# 检索结果缓存 TTL（分钟）：fileId 内容不可变，短 TTL 足够
REDIS_SEARCH_TTL_MINUTES=60

# ---- LLM 动态设置存储（前端「模型设置」页，backend 独占写 PostgreSQL，本服务只读）----
# 与 backend 同库（settings 表 key='llm'）；可单独覆盖：
# LLM_SETTINGS_DATABASE_URL=postgres://ai_office:ai_office@127.0.0.1:5432/ai_office
# 设置内存缓存 TTL（秒）：切模型后最多延迟这么久生效；0 = 每次实读（严格即时）
# LLM_SETTINGS_CACHE_TTL_SECONDS=3
