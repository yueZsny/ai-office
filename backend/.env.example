# 服务端口
PORT=3001
# AI 服务地址
AI_SERVICE_URL=http://localhost:8000
# 上传文件目录
UPLOAD_DIR=./data/uploads
# 处理结果目录
PROCESSED_DIR=./data/processed
# ---- PostgreSQL（文件元信息 + LLM 设置的事实源；本地开发指向本机 PG16，compose 内为 postgres:5432）----
DATABASE_URL=postgres://ai_office:ai_office@127.0.0.1:5432/ai_office
# PG 启动连接超时（毫秒）：超时即启动失败退出（元信息不做降级，宁可起不来）
PG_CONNECT_TIMEOUT_MS=3000
# PG 连接池上限
PG_POOL_MAX=10
# 日志目录（request.log）
LOG_DIR=./data
# ---- Redis（仅限流计数，fail-open：连不上只告警，业务照常）----
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=3000
# 上传大小限制（MB）
MAX_FILE_SIZE_MB=20
# CORS 允许来源（逗号分隔，部署到 VPS/局域网时追加）
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# parsing 状态超时（分钟）：backend 启动时将超时的 parsing 记录置为 failed
PARSING_TIMEOUT_MINUTES=5

# ---- 网关限流（固定窗口 per-IP；GET 轮询接口豁免；本地自测可临时关掉）----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# 问答/摘要/思维导图（LLM 端点）
RATE_LIMIT_QA_PER_MINUTE=30
# 文档生成（LLM 端点）
RATE_LIMIT_GENERATE_PER_MINUTE=30
# 上传/加入知识库（multer 内存 + 后台解析）
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# PDF→Word 转换（CPU 密集）
RATE_LIMIT_CONVERT_PER_MINUTE=10
# 反向代理（nginx）后必须开启，否则 req.ip 恒为代理地址 → 全站共享一桶
TRUST_PROXY=false
