# 服务端口
PORT=3001
# AI 服务地址
AI_SERVICE_URL=http://localhost:8000
# 上传文件目录
UPLOAD_DIR=./data/uploads
# 处理结果目录
PROCESSED_DIR=./data/processed
# 文件元信息存储
META_FILE=./data/files.json
# 上传大小限制（MB）
MAX_FILE_SIZE_MB=20
# CORS 允许来源（逗号分隔，部署到 VPS/局域网时追加）
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# parsing 状态超时（分钟）：backend 启动时将超时的 parsing 记录置为 failed
PARSING_TIMEOUT_MINUTES=5
